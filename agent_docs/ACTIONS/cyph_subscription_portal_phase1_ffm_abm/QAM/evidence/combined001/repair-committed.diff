++      const blend = (f: number[], b: number[]) => [0, 1, 2].map((k) => f[k] * f[3] + b[k] * (1 - f[3]));
++      const lum = (a: number[]) =>
++        a
++          .map((v) => {
++            v /= 255;
++            return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
